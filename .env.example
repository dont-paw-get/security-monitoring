APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# 관측 — 로깅 (app/core/logging_config.py)
# stdout JSON 구조화 로그 -> Grafana Alloy -> Loki.
# 로컬에서 사람이 읽는 형식으로 보려면 LOG_FORMAT=text 로 둔다.
LOG_LEVEL=INFO
LOG_FORMAT=text

# 관측 — 분산 추적 (app/core/observability.py)
# OTEL_EXPORTER_OTLP_ENDPOINT 가 비어 있으면 tracing 자체가 켜지지
# 않는다(로컬 개발/테스트 기본값). collector 를 띄워 확인하려면 아래
# 주석을 풀고 실제 주소를 넣는다. exporter 는 OTLP http/protobuf 이므로
# 포트는 4317(gRPC)이 아니라 4318 이다.
OTEL_SERVICE_NAME=security-monitoring
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local

# CLIAR-252: 실제 탐지 로직이 없는 lifecycle 골격만 있으므로 기본값은
# false다. 켜도 앱 동작에는 영향이 없다(app/services/monitoring_worker.py).
MONITORING_ENABLED=false

# CLIAR-259: GuardDuty SQS Consumer 설정. MONITORING_ENABLED=false인
# 동안에는 아래 값이 없어도 정상 기동한다(boto3 client 생성/AWS API
# 호출이 전혀 발생하지 않음). 비밀값이 아니지만 실제 Queue URL은
# 계정/환경별 값이라 코드에 하드코딩하지 않는다.
AWS_REGION=ap-northeast-2
# SQS_GUARDDUTY_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/<ACCOUNT_ID>/dpyb-security-monitoring-guardduty-dev

# CLIAR-264: GuardDuty Finding Bedrock AI 분석 설정. 둘 다 비밀값이
# 아니며(모델 ID/리전), 실제 인증은 IRSA(Runtime IAM Role)로만 이뤄진다
# — static AWS credential은 두지 않는다.
BEDROCK_REGION=ap-northeast-2
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
